# gmail-mcp-server — environment variable reference
#
# Every config key (see examples/config.readonly.json and the HLD §10) can be overridden
# with an environment variable. Rules:
#   - Prefix:           GMAIL_MCP_
#   - Nesting separator: _ (one underscore per object level)
#   - Names are matched case-insensitively against the config keys, so a camelCase key
#     becomes a single UPPERCASE segment (e.g. oauth.credentialsPath ->
#     GMAIL_MCP_OAUTH_CREDENTIALSPATH).
#   - Booleans accept: true/false, 1/0, yes/no, on/off.
#   - Array values are comma-separated.
# Precedence (low -> high): defaults < ~/.gmail-mcp/config.json < ./.gmail-mcp.json < env.
# Values shown below are the defaults. Copy what you need into your shell/.env; unset
# variables fall back to the config files and then the defaults.

# --- Top level ---
GMAIL_MCP_ACTIVEPROFILE=default
GMAIL_MCP_TRANSPORT=stdio                  # stdio | http

# --- OAuth (oauth.*) ---
GMAIL_MCP_OAUTH_CREDENTIALSPATH=~/.gmail-mcp/credentials.json
GMAIL_MCP_OAUTH_TOKENPATH=~/.gmail-mcp/tokens/default.json
# Comma-separated full scope URIs:
GMAIL_MCP_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# --- Feature flags (features.*) — read on, write/optional off by default ---
GMAIL_MCP_FEATURES_PROFILE=true
GMAIL_MCP_FEATURES_LABELS=true
GMAIL_MCP_FEATURES_LABELSWRITE=false       # gates gmail_create_label (NOT gmail_list_labels)
GMAIL_MCP_FEATURES_SEARCH=true
GMAIL_MCP_FEATURES_READMESSAGES=true
GMAIL_MCP_FEATURES_READTHREADS=true
GMAIL_MCP_FEATURES_ATTACHMENTS=true
GMAIL_MCP_FEATURES_DRAFTS=false
GMAIL_MCP_FEATURES_SEND=false
GMAIL_MCP_FEATURES_MODIFY=false
GMAIL_MCP_FEATURES_HISTORY=false

# --- Limits (limits.*) ---
GMAIL_MCP_LIMITS_DEFAULTPAGESIZE=10
GMAIL_MCP_LIMITS_MAXPAGESIZE=100
GMAIL_MCP_LIMITS_MAXMESSAGEBODYCHARS=20000
GMAIL_MCP_LIMITS_MAXATTACHMENTBYTES=52428800
GMAIL_MCP_LIMITS_MAXBULKDOWNLOADCOUNT=50
GMAIL_MCP_LIMITS_TOOLRESPONSEBODYCHARLIMIT=50000

# --- Downloads (downloads.*) ---
GMAIL_MCP_DOWNLOADS_ENABLED=true
GMAIL_MCP_DOWNLOADS_ROOTDIR=~/Downloads/gmail-mcp
GMAIL_MCP_DOWNLOADS_PRESERVEORIGINALFILENAMES=true
GMAIL_MCP_DOWNLOADS_COLLISIONPOLICY=append-counter   # append-counter | overwrite | fail | content-addressed
# Comma-separated. Empty allowlist means "allow any MIME type":
GMAIL_MCP_DOWNLOADS_ALLOWEDMIMETYPES=
GMAIL_MCP_DOWNLOADS_BLOCKEDEXTENSIONS=.exe,.dll,.bat,.cmd,.ps1,.vbs,.js,.scr,.com,.jar,.msi
GMAIL_MCP_DOWNLOADS_INCLUDEINLINEATTACHMENTSBYDEFAULT=false

# --- Safety (safety.*) ---
GMAIL_MCP_SAFETY_REQUIRECONFIRMATIONFORSEND=true
GMAIL_MCP_SAFETY_REQUIRECONFIRMATIONFORMODIFY=true
GMAIL_MCP_SAFETY_REQUIRECONFIRMATIONFORBULKDOWNLOAD=true
GMAIL_MCP_SAFETY_BULKDOWNLOADCONFIRMATIONTHRESHOLD=10
GMAIL_MCP_SAFETY_REDACTACCESSTOKENSINLOGS=true       # defense in depth; never enables token logging
GMAIL_MCP_SAFETY_DISABLERAWHTMLBODYBYDEFAULT=true
GMAIL_MCP_SAFETY_ALLOWRAWMESSAGE=false

# --- Logging (logging.*) ---
GMAIL_MCP_LOGGING_LEVEL=info               # fatal | error | warn | info | debug | trace | silent
GMAIL_MCP_LOGGING_AUDITLOGPATH=~/.gmail-mcp/audit.jsonl

# --- Test-only (NOT a config key) ---
# Opt in to live Gmail tests; read only by the test harness, ignored by the config loader.
# GMAIL_MCP_LIVE_TESTS=1
